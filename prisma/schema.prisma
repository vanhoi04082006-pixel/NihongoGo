// NihongoGo — Prisma schema
// provider = "postgresql" (production: Neon) — schema CỐ TÍNH portable:
// không dùng enum/Json native của Prisma (mọi thứ là String + validate Zod ở
// application layer) nên chuyển từ SQLite sang PostgreSQL là 1 dòng.
// Dev local vẫn chạy được nếu bạn tạm đổi provider về "sqlite" + đổi
// DATABASE_URL thành file:../db/custom.db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ================================ Identity ================================ */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("USER") // USER | EDITOR | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           UserProfile?
  settings          UserSettings?
  sessions          Session[]
  progress          UserProgress?
  streak            UserStreak?
  heart             UserHeart?
  lessonProgress    LessonProgress[]
  nodeProgress      NodeProgress[]
  lessonSessions    LessonSession[]
  attempts          ExerciseAttempt[]
  xpTransactions    XPTransaction[]
  achievements      UserAchievement[]
  dailyQuests       UserDailyQuest[]
  srsItems          SRSItem[]
  srsReviews        SRSReview[]
  mistakes          Mistake[]
  leaderboardEntrys LeaderboardEntry[]
  analyticsEvents   AnalyticsEvent[]
  adminLogs         AdminAuditLog[]
  kanaProgress      KanaProgress[]
}

model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  avatarSeed       String    @default("sakura")
  goal             String? // TRAVEL | ANIME | JLPT | WORK | STUDY | SOCIAL | OTHER
  dailyGoalXP      Int       @default(20)
  timezone         String    @default("Asia/Ho_Chi_Minh")
  kanaKnowledge    String    @default("NONE") // NONE | SOME | HIRAGANA | BOTH
  level            String    @default("BEGINNER")
  placementResult  String? // JSON
  onboardedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String   @default("system") // light | dark | system
  soundEnabled  Boolean  @default(true)
  romajiDisplay Boolean  @default(true)
  autoSpeak     Boolean  @default(false)
  reducedMotion Boolean  @default(false)
  kanaMasteryTarget Int  @default(10) // số lần trả lời đúng để "thành thạo" một ký tự kana
  updatedAt     DateTime @updatedAt
}

/* ================================ Content ================================= */

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  titleJa     String?
  description String
  order       Int           @default(0)
  status      String        @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  sections    Section[]
  lessons     Lesson[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Section {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  title       String
  titleJa     String?
  description String
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id                String         @id @default(cuid())
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId         String
  section           Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug              String         @unique
  order             Int
  title             String
  titleJa           String
  description       String
  learningObjectives String        @default("[]") // JSON: string[]
  grammarTopics     String         @default("[]")
  vocabularyTopics  String         @default("[]")
  kanjiTopics       String         @default("[]")
  difficulty        String         @default("BEGINNER")
  status            String         @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  nodes             LessonNode[]
  vocabularies      Vocabulary[]
  grammarPoints     GrammarPoint[]
  lessonProgress    LessonProgress[]

  @@index([courseId])
  @@index([sectionId, order])
}

model LessonNode {
  id            String   @id @default(cuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  key           String
  title         String
  description   String?
  icon          String   @default("Star")
  nodeType      String   @default("MIXED")
  order         Int
  xpReward      Int      @default(10)
  requiredScore Int      @default(70)
  difficulty    String   @default("EASY")
  status        String   @default("PUBLISHED")
  exercises     Exercise[]
  nodeProgress  NodeProgress[]
  sessions      LessonSession[]

  @@unique([lessonId, key])
  @@index([lessonId, order])
}

model Exercise {
  id          String    @id @default(cuid())
  nodeId      String
  node        LessonNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type        String
  prompt      String?
  instructions String?
  order       Int
  status      String    @default("PUBLISHED")
  questions   Question[]

  @@index([nodeId, order])
}

model Question {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type        String
  prompt      String?
  data        String // JSON — nội dung đề (client-safe sau sanitize)
  correctData String // JSON — đáp án, KHÔNG BAO GIỜ gửi về client trước khi trả lời
  explanation String?
  order       Int
  itemRefType String? // VOCAB | KANJI | GRAMMAR | KANA
  itemRefKey  String?
  attempts    ExerciseAttempt[]
  mistakes    Mistake[]

  @@index([exerciseId, order])
}

/* ============================ Language content ============================= */

model Vocabulary {
  id        String   @id @default(cuid())
  lessonId  String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  term      String
  reading   String?
  romaji    String
  meaningVi String
  pos       String?
  exampleJa String
  exampleVi String
  createdAt DateTime @default(now())

  @@index([term])
  @@index([lessonId])
}

model GrammarPoint {
  id            String   @id @default(cuid())
  code          String   @unique
  lessonId      String?
  lesson        Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title         String
  explanationVi String
  examples      String   @default("[]") // JSON: {ja, vi}[]
  createdAt     DateTime @default(now())

  @@index([lessonId])
}

model Kanji {
  id         String   @id @default(cuid())
  character  String   @unique
  meaningVi  String
  onyomi     String   @default("[]") // JSON: string[]
  kunyomi    String   @default("[]")
  jlpt       Int      @default(5)
  strokeCount Int
  radicals   String   @default("[]")
  examples   String   @default("[]") // JSON: {word, reading, meaningVi}[]
  mnemonicVi String?
  createdAt  DateTime @default(now())
}

model KanaCharacter {
  id              String   @id @default(cuid())
  character       String
  romaji          String
  type            String // HIRAGANA | KATAKANA
  kanaGroup       String // BASIC | DAKUTEN | HANDAKUTEN | YOUON
  row             Int
  strokeCount     Int
  exampleWord     String
  exampleReading  String
  exampleMeaning  String
  createdAt       DateTime @default(now())
  progress        KanaProgress[]

  @@unique([character, type])
  @@index([type, kanaGroup])
}

/** Tiến độ thành thạo từng ký tự kana (server-authoritative: chỉ tăng khi server chấm đúng). */
model KanaProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanaId          String
  kana            KanaCharacter @relation(fields: [kanaId], references: [id], onDelete: Cascade)
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  lastPracticedAt DateTime @default(now())
  completedAt     DateTime?

  @@unique([userId, kanaId])
  @@index([userId])
}

model AudioAsset {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  text         String
  voice        String   @default("tongtong")
  speed        Float    @default(1)
  provider     String   @default("zai-sdk")
  mimeType     String   @default("audio/wav")
  filePath     String
  byteSize     Int      @default(0)
  createdAt    DateTime @default(now())
  lastAccessAt DateTime @default(now())
}

/* ============================== Learning flow ============================== */

model LessonSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId        String?
  node          LessonNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  sessionType   String    @default("LESSON") // LESSON | PRACTICE | MISTAKE
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | FAILED | ABANDONED
  state         String // JSON: { questionIds, index, correctIds, wrongIds, combo, hearts, startedAt, mode }
  totalQuestions Int      @default(0)
  correctCount  Int       @default(0)
  wrongCount    Int       @default(0)
  heartsLeft    Int       @default(5)
  maxCombo      Int       @default(0)
  xpEarned      Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
  attempts      ExerciseAttempt[]

  @@index([userId, status])
}

model ExerciseAttempt {
  id          String        @id @default(cuid())
  sessionId   String
  session     LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String?
  question    Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  isCorrect   Boolean
  score       Float?
  answerData  String        @default("{}") // JSON
  timeSpentMs Int?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
}

model UserProgress {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXP          Int      @default(0)
  lessonsCompleted Int      @default(0) // số node hoàn thành
  perfectLessons   Int      @default(0)
  listeningNodes   Int      @default(0)
  speakingNodes    Int      @default(0)
  studyTimeSeconds Int      @default(0)
  currentLeague    String   @default("SAKURA")
  lastWeekRank     Int?
  updatedAt        DateTime @updatedAt
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status          String    @default("IN_PROGRESS")
  bestScore       Float     @default(0)
  timesCompleted  Int       @default(0)
  completedAt     DateTime?

  @@unique([userId, lessonId])
}

model NodeProgress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        LessonNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status      String      @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | MASTERED
  bestScore   Float       @default(0)
  lastScore   Float?
  attempts    Int         @default(0)
  mastery     Int         @default(0)
  completedAt DateTime?

  @@unique([userId, nodeId])
}

/* ============================== Gamification =============================== */

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String // LESSON_COMPLETE | PERFECT_BONUS | FIRST_COMPLETION | COMBO_BONUS | QUEST_REWARD | ACHIEVEMENT_REWARD | REVIEW | PRACTICE
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD theo timezone của user
  freezeCount    Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model UserHeart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hearts    Int      @default(5)
  maxHearts Int      @default(5)
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  icon        String
  tier        String // BRONZE | SILVER | GOLD | DIAMOND
  category    String
  metric      String // xem AchievementMetric
  threshold   Int
  xpReward    Int      @default(10)
  createdAt   DateTime @default(now())

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model QuestTemplate {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  description String
  icon        String
  metric      String
  target      Int
  rewardXP    Int
  active      Boolean          @default(true)
  quests      UserDailyQuest[]
}

model UserDailyQuest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD theo timezone của user
  progress    Int           @default(0)
  target      Int
  rewardXP    Int
  completedAt DateTime?

  @@unique([userId, templateId, date])
  @@index([userId, date])
}

model Leaderboard {
  id        String             @id @default(cuid())
  seasonKey String // vd '2025-09-29' (thứ Hai của tuần, timezone chuẩn)
  league    String
  startsAt  DateTime
  endsAt    DateTime
  status    String             @default("ACTIVE")
  entries   LeaderboardEntry[]

  @@unique([seasonKey, league])
  @@index([league, status])
}

model LeaderboardEntry {
  id            String      @id @default(cuid())
  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyXP      Int         @default(0)
  rank          Int?
  updatedAt     DateTime    @updatedAt

  @@unique([leaderboardId, userId])
  @@index([leaderboardId, weeklyXP])
}

/* =================================== SRS =================================== */

model SRSItem {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType       String // VOCAB | KANJI | GRAMMAR | KANA
  itemKey        String
  ease           Float       @default(2.5)
  intervalDays   Float       @default(0)
  difficulty     Float       @default(5)
  stability      Float       @default(0)
  reviewCount    Int         @default(0)
  lapseCount     Int         @default(0)
  mastery        Int         @default(0) // 0-5
  state          String      @default("NEW") // NEW | LEARNING | REVIEW | MASTERED
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  reviews        SRSReview[]

  @@unique([userId, itemType, itemKey])
  @@index([userId, nextReviewAt])
}

model SRSReview {
  id           String   @id @default(cuid())
  srsItemId    String
  srsItem      SRSItem  @relation(fields: [srsItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       String // AGAIN | HARD | GOOD | EASY
  intervalDays Float
  wasCorrect   Boolean
  reviewedAt   DateTime @default(now())

  @@index([userId, reviewedAt])
}

model Mistake {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  nodeId        String?
  itemType      String?
  itemKey       String?
  prompt        String    @default("")
  correctAnswer String    @default("")
  userAnswer    String    @default("")
  timesWrong    Int       @default(1)
  resolvedAt    DateTime?
  lastWrongAt   DateTime  @default(now())

  @@unique([userId, questionId])
  @@index([userId, resolvedAt])
}

/* =================================== Ops =================================== */

model SystemConfig {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String // CREATE | UPDATE | DELETE | PUBLISH | ARCHIVE | LOGIN
  entity    String
  entityId  String?
  before    String? // JSON
  after     String? // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContentVersion {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  version    Int
  data       String // JSON snapshot
  authorId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  props     String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
